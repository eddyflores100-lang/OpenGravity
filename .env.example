# === OpenGravity V10.5 Environment Variables ===

# --- Telegram Bot (core service) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM providers (Telegram bot router + experiment scripts) ---
MISTRAL_API_KEY=your_mistral_api_key
MOONSHOT_API_KEY=your_moonshot_api_key
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_8=
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Local LLM proxies (optional, paired with Gemini keys)
LAUNCH_URL_11435=
LAUNCH_URL_11436=

# --- Web search (V10 orchestrator) ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare Workers AI (Thesis Synthesis) ---
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# --- Oracle (FastAPI backend) ---
# Comma-separated list of allowed origins. Use * only for local dev.
CORS_ORIGINS=*
# Public URL agents use to call back /callback/agent-report/{id}
PUBLIC_BASE_URL=http://host.docker.internal:8000
# DeerFlow investigation endpoint
DEERFLOW_URL=http://localhost:2026/api/langgraph/investigate

# --- UI (Next.js dashboard) ---
# URL the BROWSER uses to reach the Oracle
NEXT_PUBLIC_API_URL=http://localhost:8000
